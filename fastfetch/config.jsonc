{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/lazyos.txt",
    "color": {
      "1": "blue",
      "2": "cyan"
    }
  },
  "display": {
    "separator": "  ",
    "color": "cyan"
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "#7ab3d4",
        "at": "#b8d4e8",
        "host": "#e8f4ff"
      }
    },
    "separator",
    { "type": "os",      "key": "  OS",      "keyColor": "#7ab3d4" },
    { "type": "kernel",  "key": "  Kernel",  "keyColor": "#7ab3d4" },
    { "type": "shell",   "key": "  Shell",   "keyColor": "#7ab3d4" },
    { "type": "wm",      "key": "  WM",      "keyColor": "#7ab3d4" },
    { "type": "terminal","key": "  Term",    "keyColor": "#7ab3d4" },
    { "type": "cpu",     "key": "  CPU",     "keyColor": "#7ab3d4" },
    { "type": "gpu",     "key": "  GPU",     "keyColor": "#7ab3d4" },
    { "type": "memory",  "key": "  RAM",     "keyColor": "#7ab3d4" },
    { "type": "disk",    "key": "  Disk",    "keyColor": "#7ab3d4" },
    { "type": "uptime",  "key": "  Uptime",  "keyColor": "#7ab3d4" },
    "separator",
    { "type": "colors", "symbol": "circle" }
  ]
}
