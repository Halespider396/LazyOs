#!/bin/bash

step "–" "Installing LazyOS packages (Hyprland + tools + AUR)..."

arch-chroot /mnt /bin/bash << CHROOT
set -euo pipefail
BUILD_USER="${USERNAME}"

# ── Base packages ─────────────────────────────────────────────────────────
pacman -S --noconfirm --needed \$(cat /root/lazyos-base.packages) || exit 1

# ── yay (AUR helper) ──────────────────────────────────────────────────────
BUILD_DIR="/tmp/yay-build"
rm -rf "\$BUILD_DIR"
mkdir -p "\$BUILD_DIR"
chown "\$BUILD_USER":"\$BUILD_USER" "\$BUILD_DIR"
sudo -u "\$BUILD_USER" git clone https://aur.archlinux.org/yay.git "\$BUILD_DIR"
sudo -u "\$BUILD_USER" bash -c "cd '\$BUILD_DIR' && makepkg -si --noconfirm --needed"
rm -rf "\$BUILD_DIR"
command -v yay &>/dev/null || { echo "yay not found!"; exit 1; }

# ── AUR packages ──────────────────────────────────────────────────────────
sudo -u "\$BUILD_USER" yay -S --noconfirm --needed \$(cat /root/lazyos-aur.packages)

# ── Enable services (only after all packages are installed) ───────────────
systemctl enable greetd.service
systemctl enable bluetooth.service

# pipewire is a user service (socket-activated), not a system unit
sudo -u "\$BUILD_USER" XDG_RUNTIME_DIR="/run/user/\$(id -u \$BUILD_USER)" systemctl --user enable pipewire.service pipewire-pulse.service wireplumber.service 2>/dev/null || true

echo "Packages installed."
CHROOT

ok "Packages installed"
