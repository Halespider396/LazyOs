#!/bin/bash

# ── Colors ─────────────────────────────────────────────────────────────────
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Functions ──────────────────────────────────────────────────────────────
step() { echo -e "\n${CYAN}[$1]${NC} $2"; }
info() { echo -e "${YELLOW} →${NC} $1"; }
ok()   { echo -e "${GREEN} ✓${NC} $1"; }
die()  { echo -e "\n${RED}[ERROR]${NC} $1"; exit 1; }
