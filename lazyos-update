#!/bin/bash
# ══════════════════════════════════════════════════════════════
# lazyos-update — LazyOS full system updater
# Updates packages + dotfiles + lazy itself
# ══════════════════════════════════════════════════════════════

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
PURPLE='\033[0;35m'
NC='\033[0m'

info()  { echo -e "${CYAN}  →${NC} $1"; }
ok()    { echo -e "${GREEN}  ✓${NC} $1"; }
err()   { echo -e "${RED}  ✗${NC} $1"; exit 1; }
warn()  { echo -e "${YELLOW}  !${NC} $1"; }
step()  { echo -e "\n${PURPLE}[$1]${NC} $2"; }

DOTFILES_DIR="$HOME/.config"
DOTFILES_REPO="https://github.com/Halespider396/lazyos-dotfiles.git"
DOTFILES_CACHE="$HOME/.cache/lazyos-dotfiles"

[ "$EUID" -ne 0 ] && err "Run with sudo: sudo lazyos-update"

clear
echo -e "${CYAN}"
cat << "ART"
    __                        ____  _____
   / /   ____ _____  __  __  / __ \/ ___/
  / /   / __ `/_  / / / / / / / / /\__ \
 / /___/ /_/ / / /_/ /_/ / / /_/ /___/ /
/_____/\__,_/ /___/\__, /  \____//____/
                  /____/
ART
echo -e "${NC}"
echo -e "${CYAN}  ══════════════════════════════════════════════════${NC}"
echo -e "   LazyOS System Updater"
echo -e "${CYAN}  ══════════════════════════════════════════════════${NC}"
echo ""

# ── Track what changed ─────────────────────────────────────
PACMAN_UPDATED=0
AUR_UPDATED=0
DOTFILES_UPDATED=0
LAZY_UPDATED=0

# ── Step 1: Pacman ─────────────────────────────────────────
step "1/4" "Updating pacman packages..."
PACMAN_BEFORE=$(pacman -Q | wc -l)
pacman -Syu --noconfirm && PACMAN_UPDATED=1 || warn "pacman update had issues."
PACMAN_AFTER=$(pacman -Q | wc -l)
ok "Pacman done. ($((PACMAN_AFTER - PACMAN_BEFORE)) new packages)"

# ── Step 2: AUR ────────────────────────────────────────────
step "2/4" "Updating AUR packages..."
sudo -u "$SUDO_USER" yay -Syu --noconfirm --aur && AUR_UPDATED=1 || warn "AUR update had issues."
ok "AUR done."

# ── Step 3: LazyOS dotfiles ────────────────────────────────
step "3/4" "Pulling latest LazyOS dotfiles..."
if [ -d "$DOTFILES_CACHE" ]; then
  info "Updating existing dotfiles cache..."
  git -C "$DOTFILES_CACHE" pull && DOTFILES_UPDATED=1 || warn "Could not pull dotfiles."
else
  info "Cloning dotfiles..."
  sudo -u "$SUDO_USER" git clone "$DOTFILES_REPO" "$DOTFILES_CACHE" && DOTFILES_UPDATED=1 || warn "Could not clone dotfiles."
fi

if [ "$DOTFILES_UPDATED" -eq 1 ]; then
  info "Applying updated configs..."
  CONFIGS="hypr waybar wofi swaync hyprlock hypridle hyprpaper alacritty fastfetch wlogout"
  for dir in $CONFIGS; do
    [ -d "$DOTFILES_CACHE/$dir" ] && cp -r "$DOTFILES_CACHE/$dir/" "$DOTFILES_DIR/" && info "  updated: $dir"
  done
  [ -f "$DOTFILES_CACHE/zsh/.zshrc" ] && cp "$DOTFILES_CACHE/zsh/.zshrc" "/home/$SUDO_USER/.zshrc"
  chown -R "$SUDO_USER":"$SUDO_USER" "$DOTFILES_DIR"
  ok "Dotfiles applied."
fi

# ── Step 4: lazy itself ────────────────────────────────────
step "4/4" "Updating lazy command..."
if [ -f "$DOTFILES_CACHE/lazy" ]; then
  cp "$DOTFILES_CACHE/lazy" /usr/local/bin/lazy
  chmod +x /usr/local/bin/lazy
  LAZY_UPDATED=1
  ok "lazy updated."
else
  info "lazy is already up to date."
fi

# ── Summary ────────────────────────────────────────────────
echo ""
echo -e "${CYAN}  ══════════════════════════════════════════════════${NC}"
echo -e "   Update Summary"
echo -e "${CYAN}  ══════════════════════════════════════════════════${NC}"
echo ""
[ "$PACMAN_UPDATED"    -eq 1 ] && echo -e "   ${GREEN}✓${NC} Pacman packages updated" || echo -e "   ${YELLOW}!${NC} Pacman skipped"
[ "$AUR_UPDATED"       -eq 1 ] && echo -e "   ${GREEN}✓${NC} AUR packages updated"    || echo -e "   ${YELLOW}!${NC} AUR skipped"
[ "$DOTFILES_UPDATED"  -eq 1 ] && echo -e "   ${GREEN}✓${NC} Dotfiles updated"        || echo -e "   ${YELLOW}!${NC} Dotfiles skipped"
[ "$LAZY_UPDATED"      -eq 1 ] && echo -e "   ${GREEN}✓${NC} lazy updated"            || echo -e "   ${YELLOW}!${NC} lazy skipped"
echo ""
echo -e "   ${CYAN}Reload Hyprland?${NC} Run: hyprctl reload"
echo ""
